    "autoprefixer": "^10.4.19",
    "cspell": "^8.14.2",
    "cypress": "^13.5.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
